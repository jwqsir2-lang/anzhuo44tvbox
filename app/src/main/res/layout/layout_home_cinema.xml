<?xml version="1.0" encoding="utf-8"?>
<!--
  传统 TVBox 风格首页
  结构：左侧竖导航 + 右侧「一级分类 → 二级分类 → 海报墙（占满剩余空间）→ 历史一行」
  相对原影院布局的改动：
    1. 移除 Hero 大图（190dp），纵向空间全部还给海报墙
    2. 历史区从顶部整行移到海报墙下方，仅在有历史时显示，且高度压缩
    3. 分类条移到最上方，符合传统 TVBox 的操作顺序
-->
<com.tvbox.android44.common.StateLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_state"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- 左侧图标导航（与内容区有分界） -->
        <LinearLayout
            android:id="@+id/home_cinema_rail"
            android:layout_width="88dp"
            android:layout_height="match_parent"
            android:background="@color/card_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/theme_cinema"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cinema_nav_history"
                style="@style/Widget.Tv.CinemaRailItem"
                android:text="@string/nav_history_vertical" />

            <TextView
                android:id="@+id/cinema_nav_search"
                style="@style/Widget.Tv.CinemaRailItem"
                android:text="@string/nav_search_vertical" />

            <TextView
                android:id="@+id/cinema_nav_recommend"
                style="@style/Widget.Tv.CinemaRailItem"
                android:text="@string/nav_recommend_vertical" />

            <TextView
                android:id="@+id/cinema_nav_live_tv"
                style="@style/Widget.Tv.CinemaRailItem"
                android:visibility="gone"
                android:text="@string/nav_live_tv_vertical" />

            <TextView
                android:id="@+id/cinema_nav_platform_live"
                style="@style/Widget.Tv.CinemaRailItem"
                android:visibility="gone"
                android:text="@string/nav_platform_live_vertical" />

            <TextView
                android:id="@+id/cinema_nav_settings"
                style="@style/Widget.Tv.CinemaRailItem"
                android:text="@string/nav_settings_vertical" />
        </LinearLayout>

        <!-- 右侧：分类条 + 海报墙 + 历史一行 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_sub_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/home_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:scrollbars="none" />

            <include layout="@layout/section_home_continue" />
        </LinearLayout>
    </LinearLayout>
</com.tvbox.android44.common.StateLayout>
